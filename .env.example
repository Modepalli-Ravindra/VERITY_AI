# ==============================================================================
# VERITY AI — Production & Development Environment Configuration Template
# ==============================================================================
# Copy this template to .env or .env.local and configure your environment.
# DO NOT commit real secrets, API keys, or JWT credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & API Server Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed origins for CORS (browser clients)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=verity-local-sqlite-secret-key-2026

# ------------------------------------------------------------------------------
# 2. Database Configuration (Local SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///backend/data/verity.db

# ------------------------------------------------------------------------------
# 3. Machine Learning Detector Configuration
# ------------------------------------------------------------------------------
# Primary production detection model:
# - 'modernbert' (ModernBERT V5 + Stylometrics Fusion, threshold: 0.70)
# - 'distilroberta-base' (DistilRoBERTa V2 + Stylometrics Fusion, threshold: 0.50, rollback target)
VERITY_PRIMARY_MODEL=distilroberta-base
VERITY_TRANSFORMER_MODEL=distilroberta-base
VERITY_DETECTOR_VERSION=v2

# External LLM Fallback for text detection if local ML is unavailable (default: false)
VERITY_FALLBACK_ENABLED=false
VERITY_FALLBACK_PROVIDER=auto

# ------------------------------------------------------------------------------
# 4. Humanizer 2.0 LLM Provider Keys (Optional with cascading fallback)
# ------------------------------------------------------------------------------
# If no external keys are configured, VERITY automatically uses its local rule engine.
GOOGLE_API_KEY=your_google_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

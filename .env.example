# VERITY Environment Configuration Template
# Copy to .env or .env.local

# ML Transformer Model (Default: distilroberta-base)
VERITY_TRANSFORMER_MODEL=distilroberta-base

# InsForge BaaS Backend URL
NEXT_PUBLIC_INSFORGE_URL=https://xga5neu3.us-east.insforge.app

# Optional LLM Provider Keys for Humanizer Engine
GOOGLE_API_KEY=your_google_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
